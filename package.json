{
  "name": "pos_ertiga",
  "version": "1.0.0",
  "description": "\"# Pos_Ertiga\"",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:server": "node server/server.js",
    "dev:client": "npm --prefix client run dev",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:web\"",
    "sync:turso": "node server/scripts/sync-to-turso.js",
    "build:client": "cd client && npm install && npm run build",
    "build:web": "cd web && npm install && npm run build",
    "build": "npm run build:client",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.pos.ertiga",
    "productName": "POS Ertiga",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "!server/node_modules/**",
      "!server/*.sqlite",
      "!server/*.sqlite-*",
      "!server/backups/**",
      "client/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "**/node_modules/sqlite3/**",
      "client/dist/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafirachmawan/Pos_Ertiga.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rafirachmawan/Pos_Ertiga/issues"
  },
  "homepage": "https://github.com/rafirachmawan/Pos_Ertiga#readme",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  }
}
